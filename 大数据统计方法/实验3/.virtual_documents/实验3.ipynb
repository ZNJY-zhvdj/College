def xz(arr,name):
    print(arr[arr % 2 == 1])
    print(arr[arr % 2 == 0])

    print(arr[-5:])

    print(arr[arr>5])
    print(arr[arr<5])
    
    print(arr[(arr > 3) & (arr < 7)])


