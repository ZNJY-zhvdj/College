import matplotlib.pyplot as plt

x = np.linspace(-2 * np.pi, 2 * np.pi, 400)
y = np.sin(x)

plt.plot(x, y)
plt.show()


v1 = np.array([1, 1])
v2 = np.array([1, 0])


dot = np.dot(v1, v2)

norm_v1 = np.linalg.norm(v1)
norm_v2 = np.linalg.norm(v2)

cos = (dot / (norm_v1 * norm_v2))

rad = np.arccos(cos)
deg = np.degrees(rad)

print(rad)
print(deg)



